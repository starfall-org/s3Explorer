# When S3_USE_PROXY_FALLBACK=true the server falls back to streaming every
# file through /api/s3/proxy (uses Next.js server egress bandwidth). Default
# behaviour is to let the browser stream directly from Backblaze via a short-
# lived presigned URL (1 hour) signed by this server, which avoids Backblaze
# Class B / egress-quota hits on the Next.js host.
#
# Leave unset unless your bucket CORS rules prevent the browser from calling
# the Backblaze endpoint directly.
S3_USE_PROXY_FALLBACK=false
